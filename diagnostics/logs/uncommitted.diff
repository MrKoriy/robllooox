+static int arm_stage_hex(const char* hex, char* err, size_t err_len) {
+    size_t hl = strlen(hex);
+    while (hl > 0 && (hex[hl-1] == '\n' || hex[hl-1] == '\r' ||
+                      hex[hl-1] == ' '  || hex[hl-1] == '\t')) hl--;
+    if (hl < 2 || (hl & 1)) {
+        snprintf(err, err_len, "bad hex length");
+        return -1;
+    }
+    size_t bl = hl / 2;
